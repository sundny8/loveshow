# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LoveShow

# Database (SQLite by default; change drizzle config + src/db/index.ts for Postgres)
DATABASE_URL=file:sqlite.db

# Authentication (Better-Auth)
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=onboarding@yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Providers ------------------------------------------------------------
# OpenAI (primary): gpt-image-1 or gpt-image-2
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Google Gemini (fallback): gemini-2.5-flash-image
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Photo storage dir (relative to project root). Results served via /uploads/*
PHOTO_STORAGE_DIR=./public/uploads
PHOTO_BATCH_CONCURRENCY=3

# Creem Moderation (REQUIRED for AI image / video / text generation merchants)
# https://docs.creem.io/features/moderation
# Used to screen every user-supplied prompt before it reaches a generation model.
CREEM_API_KEY=
# Override only if pointing to sandbox; default is production https://api.creem.io
# CREEM_API_URL=https://test-api.creem.io
# Timeout in ms for the moderation call (defaults to 5000).
# CREEM_MODERATION_TIMEOUT_MS=5000

# Public support email shown in the footer / mailto links.
# (UI uses a hard-coded constant in components/layout/footer.tsx — keep them in sync.)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@loveshow.life
