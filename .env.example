# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LoveShow

# Public site URL used for SEO (canonical, sitemap, OG, JSON-LD).
# In production set this to your real https origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://loveshow.life

# Database (SQLite by default; change drizzle config + src/db/index.ts for Postgres)
DATABASE_URL=file:sqlite.db

# Authentication (Better-Auth)
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=onboarding@yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Providers ------------------------------------------------------------
# OpenAI (primary): gpt-image-1 or gpt-image-2
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Google Gemini (fallback): gemini-2.5-flash-image
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Photo storage dir (relative to project root). Results served via /uploads/*
PHOTO_STORAGE_DIR=./public/uploads
PHOTO_BATCH_CONCURRENCY=3

# File storage mode: tos | r2 | local
# tos:   VolcEngine TOS object storage
# r2:    Cloudflare R2 object storage (falls back to local on failure)
# local: local public/uploads dir
FILE_STORE_MODE=local
# Optional: override storage mode for AI-generated images only
# GENERATED_IMAGE_STORE_MODE=r2

# Cloudflare R2 (S3-compatible; endpoint https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public access domain (custom domain or r2.dev public URL);
# when empty, images are served via the /api/generated proxy route.
R2_PUBLIC_URL=

# Public support email shown in the footer / mailto links.
# (UI uses a hard-coded constant in components/layout/footer.tsx — keep them in sync.)
# NEXT_PUBLIC_SUPPORT_EMAIL=noreply@loveshow.life

# Creem Content Moderation (REQUIRED for production)
# https://docs.creem.io/features/moderation
# Used to screen every user-supplied generation prompt against content policies
# BEFORE the prompt is forwarded to any AI image / video / music model.
# In production a missing key fails closed (returns 503 to the user).
# In development a missing key falls back to "allow" so local work isn't blocked.
CREEM_API_KEY=
# Sandbox: https://test-api.creem.io   |   Production: https://api.creem.io (default)
# CREEM_API_BASE=https://api.creem.io
